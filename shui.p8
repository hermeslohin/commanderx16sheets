; shui.p8 - SHUI.BIN, RAM bank 63: X16 Sheets' title bar and icon toolbars (the same icons as
; X16 Write), tool tips, and the modal dialogs (text input, yes/no, message, popup menus, save conflict).
; It calls the main program through mainsyms_63.p8 (generated by tools/gen_syms.py).

%address  $A000
%memtop   $C000
%output   library
%zeropage dontuse

%import syslib
%import strings
%import icons
%import mainsyms_63

main {
    %jmptable (
        ui.setup,           ; $A003  r0 = check -> A
        ui.draw_toolbar,    ; $A006
        ui.show_tip,        ; $A009  r0L = button id
        ui.dialog_input_e,  ; $A00C  r0L = title id, r1 = buffer (main RAM), r2L = max -> A
        ui.yesno_e,         ; $A00F  r0L = message id -> A
        ui.message_e,       ; $A012  r0L = title id, r1L = message id
        ui.menu_e,          ; $A015  r0L = x, r1L = y, r2L = which -> A index / 255
        ui.conflict_e,      ; $A018  r0L = 1 exists / 0 changed -> A 0 overwrite 1 new name 2 cancel
        ui.upload_icons,    ; $A01B
    )
    sub start() {
    }
}

ui {
    const ubyte C_BLACK = 0
    const ubyte C_WHITE = 1
    const ubyte C_RED = 2
    const ubyte C_CYAN = 3
    const ubyte C_PURPLE = 4
    const ubyte C_BLUE = 6
    const ubyte C_YELLOW = 7
    const ubyte C_ORANGE = 8
    const ubyte C_LRED = 10
    const ubyte C_DGRAY = 11
    const ubyte C_GRAY = 12
    const ubyte C_LGREEN = 13
    const ubyte C_LBLUE = 14
    const ubyte C_LGRAY = 15
    const ubyte S_RAW = 8
    const ubyte S_BOLD = 1
    const uword FONT_VRAM = $6000

    ; button ids (same as sview's)
    const ubyte B_NEW = 1
    const ubyte B_OPEN = 2
    const ubyte B_SAVE = 3
    const ubyte B_SAVEAS = 4
    const ubyte B_CUT = 5
    const ubyte B_COPY = 6
    const ubyte B_PASTE = 7
    const ubyte B_ALL = 8
    const ubyte B_BOLD = 9
    const ubyte B_AL = 10
    const ubyte B_AC = 11
    const ubyte B_AR = 12
    const ubyte B_CLEAR = 13
    const ubyte B_QUIT = 14
    const ubyte B_SUM = 15
    const ubyte B_FX = 16
    const ubyte B_GEN = 17
    const ubyte B_DEC = 18
    const ubyte B_PCT = 19
    const ubyte B_CUR = 20
    const ubyte B_INSROW = 21
    const ubyte B_DELROW = 22
    const ubyte B_INSCOL = 23
    const ubyte B_DELCOL = 24
    const ubyte B_NARROW = 25
    const ubyte B_WIDER = 26

    sub setup() -> bool {
        return cx16.r0 == mn.CHECK
    }

    sub upload_icons() {
        ubyte k
        ubyte r
        sys.set_irqd()
        cx16.vaddr(1, FONT_VRAM + 3 * 2048, 0, 1)
        for k in 0 to icons.COUNT - 1 {
            for r in 0 to 7
                cx16.VERA_DATA0 = icons.ic_hi[k * 8 + r]
            for r in 0 to 7
                cx16.VERA_DATA0 = icons.ic_lo[k * 8 + r]
        }
        sys.clear_irqd()
    }

    sub fill(ubyte col, ubyte row, ubyte n, ubyte fg, ubyte bg) {
        mn.vfill(col, row, n, fg, bg)
    }

    ; Sunset icon faces by button id: file buttons pink/orange/teal, AutoSum pink, fx lavender,
    ; the rest violet with cream glyphs; a toggle that is on is black on yellow
    ubyte[27] face = [0, C_RED, C_ORANGE, C_CYAN, C_CYAN, C_GRAY, C_GRAY, C_GRAY, C_GRAY, C_GRAY,
                      C_GRAY, C_GRAY, C_GRAY, C_GRAY, C_RED, C_RED, C_PURPLE, C_GRAY, C_GRAY, C_GRAY,
                      C_GRAY, C_GRAY, C_GRAY, C_GRAY, C_GRAY, C_GRAY, C_GRAY]

    sub icon(ubyte col, ubyte row, ubyte k, ubyte id, bool active) {
        ubyte f = face[id]
        ubyte c = f << 4
        if active
            c = C_YELLOW << 4
        else if f == C_GRAY
            c |= C_WHITE
        @(mn.r_ch) = k * 2
        @(mn.r_ch + 1) = k * 2 + 1
        @(mn.r_sty) = S_RAW | $30
        @(mn.r_sty + 1) = S_RAW | $30
        @(mn.r_col) = c
        @(mn.r_col + 1) = c
        mn.render_run(row, col, 2)
        mn.add_btn(col, row, id)
    }

    ; a dialog button: label (padded with spaces) between pill caps, black on yellow
    sub button(ubyte x, ubyte y, uword label) {
        mn.pill(x, y, label, C_BLACK, C_YELLOW, C_LGRAY)
    }

    ; a chip in the title bar: " text " on black
    sub chip(ubyte x, uword s, ubyte fg) -> ubyte {
        ubyte n = strings.length(s)
        fill(x, 0, n + 2, fg, C_BLACK)
        mn.vtext(x + 1, 0, s, S_BOLD, fg, C_BLACK)
        return x + n + 2
    }

    ; ---------------- toolbars / title ----------------
    sub draw_toolbar() {
        mn.bt_n = 0
        ; Sunset title bar: stripes with black chips
        mn.stripes(0, 0, 80)
        void chip(1, iso:"X16 SHEETS", C_YELLOW)
        ubyte x = chip(14, mn.filename, C_WHITE)
        if x < 47
            x = 47
        if mn.cloud_doc
            x = chip(x, iso:"ownCloud", C_LGREEN) + 1
        if mn.modified
            void chip(x, iso:"modified", C_LRED)
        icon(77, 0, icons.I_QUIT, B_QUIT, false)

        fill(0, 1, 80, 0, C_DGRAY)
        fill(0, 2, 80, 0, C_DGRAY)
        icon(1, 1, icons.I_NEW, B_NEW, false)
        icon(4, 1, icons.I_OPEN, B_OPEN, false)
        icon(7, 1, icons.I_SAVE, B_SAVE, false)
        icon(10, 1, icons.I_SAVEAS, B_SAVEAS, false)
        icon(15, 1, icons.I_CUT, B_CUT, false)
        icon(18, 1, icons.I_COPY, B_COPY, false)
        icon(21, 1, icons.I_PASTE, B_PASTE, mn.clip_any)
        icon(24, 1, icons.I_ALL, B_ALL, false)
        icon(29, 1, icons.I_CLEAR, B_CLEAR, false)
        ubyte st = 0
        if mn.get(mn.cur_r, mn.cur_c)
            st = @(mn.R + 4)
        ubyte al = (st >> 1) & 3
        ubyte fm = (st >> 3) & 3
        icon(34, 1, icons.I_BOLD, B_BOLD, (st & 1) != 0)
        icon(39, 1, icons.I_AL, B_AL, al == 1)
        icon(42, 1, icons.I_AC, B_AC, al == 2)
        icon(45, 1, icons.I_AR, B_AR, al == 3)

        icon(1, 2, icons.I_SUM, B_SUM, false)
        icon(4, 2, icons.I_FX, B_FX, false)
        icon(9, 2, icons.I_GEN, B_GEN, fm == 0)
        icon(12, 2, icons.I_DEC, B_DEC, fm == 1)
        icon(15, 2, icons.I_PCT, B_PCT, fm == 2)
        icon(18, 2, icons.I_CUR, B_CUR, fm == 3)
        icon(23, 2, icons.I_INSROW, B_INSROW, false)
        icon(26, 2, icons.I_DELROW, B_DELROW, false)
        icon(29, 2, icons.I_INSCOL, B_INSCOL, false)
        icon(32, 2, icons.I_DELCOL, B_DELCOL, false)
        icon(37, 2, icons.I_NARROW, B_NARROW, false)
        icon(40, 2, icons.I_WIDER, B_WIDER, false)
        mn.put(50, 2, iso:"cells", C_LGRAY, C_DGRAY)
        mn.num(56, 2, mn.nused, C_WHITE, C_DGRAY)
        mn.put(62, 2, iso:"free", C_LGRAY, C_DGRAY)
        mn.num(67, 2, mn.free_count(), C_WHITE, C_DGRAY)
        mn.draw_fbar()
    }

    uword[] tips = [
        iso:"",
        iso:"New sheet",
        iso:"Open XLSX from SD card or ownCloud",
        iso:"Save (back to ownCloud if opened there)",
        iso:"Save As XLSX on SD card or ownCloud",
        iso:"Cut cells",
        iso:"Copy cells",
        iso:"Paste (one copied cell fills the selection)",
        iso:"Select all used cells",
        iso:"Bold",
        iso:"Align left",
        iso:"Center",
        iso:"Align right",
        iso:"Clear cells (contents and format)",
        iso:"Quit",
        iso:"AutoSum",
        iso:"Insert a function",
        iso:"Number format: General",
        iso:"Number format: 0.00",
        iso:"Number format: Percent",
        iso:"Number format: Currency",
        iso:"Insert rows above",
        iso:"Delete rows",
        iso:"Insert columns to the left",
        iso:"Delete columns",
        iso:"Narrower columns (or drag a header edge)",
        iso:"Wider columns (or drag a header edge)",
        iso:"Cancel the entry (Esc)",
        iso:"Enter the entry (Return)",
        iso:"Insert a function" ]

    sub show_tip() {
        ubyte id = cx16.r0L
        if id >= len(tips)
            id = 0
        mn.set_status(tips[id])
        mn.draw_status()
    }

    ; ---------------- dialogs ----------------
    uword[] titles = [iso:"Save XLSX on the SD card", iso:"Open XLSX from the SD card",
                      iso:"Save As to ownCloud (Documents/, .xlsx or .csv)", iso:"Sheet full", iso:"New folder name"]
    uword[] msgs = [iso:"Quit without saving?", iso:"Discard the current sheet?",
                    iso:"No room for more cells (see README).", iso:"Replace the existing file?"]

    sub draw_box(ubyte x, ubyte y, ubyte w, ubyte h) {
        ubyte r
        for r in y to y + h - 1
            fill(x, r, w, 0, C_LGRAY)
        fill(x, y, w, 0, C_BLACK)
        fill(x, y + h - 1, w, 0, C_BLACK)
    }

    ; Sunset: warnings (bg RED) keep a pink title bar with cream text, the rest lavender with black
    sub title_box(ubyte x, ubyte y, ubyte w, ubyte h, uword title, ubyte bg) {
        ubyte fg = C_WHITE
        if bg != C_RED {
            bg = C_PURPLE
            fg = C_BLACK
        }
        draw_box(x, y, w, h)
        fill(x, y, w, fg, bg)
        mn.vtext(x + 2, y, title, S_BOLD, fg, bg)
    }

    sub dialog_input_e() -> bool {
        return dialog_input(titles[cx16.r0L], cx16.r1, cx16.r2L)
    }

    ; text input; buf is a 0-terminated iso string in main RAM; true = OK
    sub dialog_input(uword title, uword buf, ubyte maxlen) -> bool {
        ubyte n = strings.length(buf)
        ubyte k
        title_box(16, 11, 48, 7, title, C_BLUE)
        mn.put(18, 13, iso:"Name:", 0, C_LGRAY)
        button(24, 16, iso:" OK ")
        button(40, 16, iso:" Cancel ")
        bool dirty = true
        mn.prev_btn = true
        repeat {
            if dirty {
                dirty = false
                ubyte i
                for i in 0 to 37 {
                    @(mn.r_ch + i) = 32
                    @(mn.r_sty + i) = 0
                    @(mn.r_col + i) = C_WHITE << 4
                }
                for i in 0 to 36 {
                    if i < n
                        @(mn.r_ch + i) = @(buf + i)
                }
                if n < 37
                    @(mn.r_col + n) = C_WHITE
                mn.render_run(13, 24, 38)
            }
            k = mn.click()
            if k == 2
                return false
            if k == 3 {
                k = mn.last_key
                if k == 13
                    return true
                if (k == 8 or k == 20) and n > 0 {
                    n--
                    @(buf + n) = 0
                    dirty = true
                } else if k >= 32 and k < 127 and n < maxlen {
                    @(buf + n) = k
                    n++
                    @(buf + n) = 0
                    dirty = true
                }
            } else if k == 1 and mn.mouse_cy == 16 {
                if mn.mouse_cx >= 24 and mn.mouse_cx < 30
                    return true
                if mn.mouse_cx >= 40 and mn.mouse_cx < 50
                    return false
            }
        }
    }

    sub yesno_e() -> bool {
        ubyte k
        ubyte m = cx16.r0L              ; drawing clobbers r0
        title_box(18, 12, 44, 5, iso:"Please confirm", C_RED)
        mn.put(20, 14, msgs[m], 0, C_LGRAY)
        button(24, 15, iso:" Yes ")
        button(46, 15, iso:" No ")
        mn.prev_btn = true
        repeat {
            k = mn.click()
            if k == 2
                return false
            if k == 3 {
                k = mn.last_key | 32
                if k == iso:'y' or mn.last_key == 13
                    return true
                if k == iso:'n'
                    return false
            }
            if k == 1 and mn.mouse_cy == 15 {
                if mn.mouse_cx >= 24 and mn.mouse_cx < 31
                    return true
                if mn.mouse_cx >= 46 and mn.mouse_cx < 52
                    return false
            }
        }
    }

    sub message_e() {
        ubyte m = cx16.r1L              ; drawing clobbers r0/r1
        title_box(14, 12, 52, 5, titles[cx16.r0L], C_BLUE)
        mn.put(16, 14, msgs[m], 0, C_LGRAY)
        button(36, 15, iso:" OK ")
        mn.prev_btn = true
        repeat {
            ubyte k = mn.click()
            if k >= 2 or (k == 1 and mn.mouse_cy == 15)
                return
        }
    }

    ; ---------------- popup menus ----------------
    uword[] @nosplit m_open = [iso:"1 Open from SD card...", iso:"2 Open from ownCloud..."]
    uword[] @nosplit m_save = [iso:"1 Save As on SD card...", iso:"2 Save As to ownCloud..."]
    uword[] @nosplit m_fx = [iso:"SUM      total", iso:"AVERAGE  mean", iso:"MIN      smallest", iso:"MAX      largest",
                    iso:"COUNT    count numbers", iso:"PRODUCT  multiply all", iso:"ABS      absolute value",
                    iso:"SQRT     square root", iso:"INT      round down", iso:"ROUND    (value, digits)",
                    iso:"IF       (test, then, else)"]

    sub menu_e() -> ubyte {
        when cx16.r2L {
            0 -> return menu(cx16.r0L, cx16.r1L, 28, &m_open, 2)
            1 -> return menu(cx16.r0L, cx16.r1L, 28, &m_save, 2)
        }
        return menu(cx16.r0L, cx16.r1L, 30, &m_fx, len(m_fx))
    }

    sub menu(ubyte x, ubyte y, ubyte w, uword items, ubyte n) -> ubyte {
        ubyte i
        draw_box(x, y, w, n + 2)
        for i in 0 to n - 1 {
            fill(x + 1, y + 1 + i, w - 2, 0, C_WHITE)
            mn.put(x + 2, y + 1 + i, peekw(items + i * 2), 0, C_WHITE)
        }
        mn.prev_btn = true
        repeat {
            ubyte k = mn.click()
            if k == 2
                return 255
            if k == 3 and n <= 9 and mn.last_key >= iso:'1' and mn.last_key < iso:'1' + n
                return mn.last_key - iso:'1'
            if k == 1 {
                if mn.mouse_cx > x and mn.mouse_cx < x + w - 1 and mn.mouse_cy > y and mn.mouse_cy <= y + n
                    return mn.mouse_cy - y - 1
                return 255
            }
        }
    }

    ; ---------------- save conflict ----------------
    sub conflict_e() -> ubyte {
        ubyte ex = cx16.r0L             ; drawing clobbers r0
        title_box(14, 11, 52, 7, iso:"Save conflict", C_RED)
        mn.put(16, 13, mn.nbuf, 0, C_LGRAY)
        if ex != 0
            mn.put(16, 14, iso:"already exists on ownCloud.", 0, C_LGRAY)
        else
            mn.put(16, 14, iso:"was changed on ownCloud since you opened it.", 0, C_LGRAY)
        button(17, 16, iso:"Overwrite")
        button(32, 16, iso:"New name")
        button(47, 16, iso:" Cancel ")
        mn.prev_btn = true
        repeat {
            ubyte k = mn.click()
            if k == 2
                return 2
            if k == 3 {
                ubyte c = mn.last_key | 32
                if c == iso:'o'
                    return 0
                if c == iso:'n'
                    return 1
                if c == iso:'c'
                    return 2
            }
            if k == 1 and mn.mouse_cy == 16 {
                if mn.mouse_cx >= 17 and mn.mouse_cx < 28
                    return 0
                if mn.mouse_cx >= 32 and mn.mouse_cx < 42
                    return 1
                if mn.mouse_cx >= 47 and mn.mouse_cx < 57
                    return 2
            }
        }
    }
}
